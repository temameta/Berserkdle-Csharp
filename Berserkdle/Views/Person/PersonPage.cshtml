@{
    ViewData["Title"] = "All persons";
}
@model Person;
<div class="text-center">
    <h1 class="display-4">@Model.Name</h1>
</div>

@{
        <div>
            <span>Id</span>
            <span>@Model.Id</span>
        </div>
        <div>
            <span>Name</span>
            <span>@Model.Name</span>
        </div>
        <div>
            <span>Gender</span>
            <span>@Model.Gender</span>
        </div>
        <div>
            <span>Species</span>
            <span>@Model.Species</span>
        </div>
        <div>
            <span>First Arc</span>
            <span>@Model.FirstArc</span>
        </div>
        <div>
            <span>Weapons</span>
            @{
                if (@Model.Weapons != null)
                {
                    foreach (var weapon in @Model.Weapons)
                    {
                        <span>@weapon</span>
                    }
                }
            }
        </div>
        <div>
            <span>Groups</span>
            @{
                if (@Model.Groups != null)
                {
                    foreach (var group in @Model.Groups)
                    {
                        <span>@group</span>
                    }
                }
            }
        </div>
}
