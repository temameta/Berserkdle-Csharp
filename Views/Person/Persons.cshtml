@{
    ViewData["Title"] = "All persons";
}
@model List<Person>;
<div class="text-center">
    <h1 class="display-4">All persons</h1>
</div>
@{
    foreach (var person in Model)
    {
        <div>
            <span>Id</span>
            <span>@person.Id</span>
        </div>
        <div>
            <span>Name</span>
            <span>@person.Name</span>
        </div>
        <a asp-controller="Person" asp-action="PersonPage" asp-route-id="@person.Id">Details</a>
    }
}
